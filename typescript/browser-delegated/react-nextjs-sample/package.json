{
  "name": "react-sample-nextjs-browser-delegated",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:passkey": "next dev --turbopack --experimental-https --experimental-https-key ./certs/auth-key.pem --experimental-https-cert ./certs/auth-cert.pem",
    "dev:appB:https": "next dev --turbopack -p 3002 --experimental-https --experimental-https-key ./certs/auth-key.pem --experimental-https-cert ./certs/auth-cert.pem",
    "proxy": "node local-proxy.mjs",
    "proxy:https": "node local-proxy.mjs --https",
    "build": "next build",
    "start": "next start",
    "lint": "eslint ."
  },
  "dependencies": {
    "@azure/communication-email": "^1.1.0",
    "@azure/communication-sms": "^1.1.0",
    "@azure/msal-browser": "^4.30.0",
    "@azure/msal-react": "^3.0.20",
    "next": "^16.0.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-next": "15.1.7",
    "typescript": "^5"
  }
}
